---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	start(start)
	think(think)
	record(record)
	gather(gather)
	decide(decide)
	auto_approve(auto_approve)
	notify_reviewer(notify_reviewer)
	human_review(human_review)
	__end__([<p>__end__</p>]):::last
	__start__ --> start;
	decide -.-> auto_approve;
	decide -.-> notify_reviewer;
	decide -.-> think;
	gather --> decide;
	human_review -.-> __end__;
	human_review -.-> think;
	notify_reviewer --> human_review;
	record -.-> decide;
	record -.-> gather;
	start --> think;
	think --> record;
	auto_approve --> __end__;
	human_review -.-> human_review;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
