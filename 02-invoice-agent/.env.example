OPENROUTER_API_KEY=
# Model that runs the investigation (must support tool calling on OpenRouter)
AGENT_MODEL=google/gemini-3.5-flash
# Optional: pin one OpenRouter provider (no fallbacks), e.g. for reproducible experiments
# AGENT_PROVIDER=Google
# Optional: prefix caching (marks a cache breakpoint each call). Pays off on long prompts.
# PROMPT_CACHE=1
# How the model's context is built each turn: structured | full_history
CONTEXT_STRATEGY=structured
MAX_TURNS=12
MAX_COST_USD=0.50
